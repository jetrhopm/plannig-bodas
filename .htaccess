Options -Indexes

<FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never use the project root as an asset directory. This protects source,
    # configuration, tests and private storage when XAMPP serves /boda.
    RewriteRule ^(?:app|bootstrap|config|database|docs|resources|routes|storage|tests|vendor)/ - [F,L,NC]

    # Public files remain in public/ even when the checkout is opened as /boda.
    RewriteRule ^(build|storage)(/.*)?$ public/$0 [L]
    RewriteRule ^images(/.*)?$ public/images$1 [L]
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L]

    # The root front controller preserves /boda as the request base path.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
